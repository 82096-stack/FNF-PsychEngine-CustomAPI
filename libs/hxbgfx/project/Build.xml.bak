	<!-- hxbgfx Build.xml — bgfx linker configuration -->
	<xml>
		<pragma once="true" />
		<set name="BGFX_DIR" value="libs/hxbgfx" />

		<target id="haxe">
			<section if="mac">
				<file name="${BGFX_DIR}/native/metalfx_bridge.mm" />
				<file name="${BGFX_DIR}/project/bgfx_bridge.cpp" />
				<file name="${BGFX_DIR}/native/fsr2_bridge.cpp" />

				<lib name="${BGFX_DIR}/lib/macos/libbgfx.a" />
				<lib name="${BGFX_DIR}/lib/macos/libbx.a" />
				<lib name="${BGFX_DIR}/lib/macos/libbimg.a" />

				<compilerflag value="-L/opt/homebrew/lib" />
				<compilerflag value="-lSDL2" />
				<compilerflag value="-framework Metal" />
				<compilerflag value="-framework MetalKit" />
				<compilerflag value="-framework MetalFX" />
				<compilerflag value="-framework QuartzCore" />
				<compilerflag value="-framework Cocoa" />
				<compilerflag value="-framework IOKit" />
				<compilerflag value="-framework Foundation" />
				<compilerflag value="-framework CoreFoundation" />
				<compilerflag value="-framework CoreVideo" />
				<compilerflag value="-framework OpenGL" />
			</section>

			<section if="windows">
				<file name="${BGFX_DIR}/project/bgfx_bridge.cpp" />
				<file name="${BGFX_DIR}/native/fsr2_bridge.cpp" />

				<lib name="${BGFX_DIR}/lib/windows/x64/bgfx.lib" if="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/windows/x64/bx.lib" if="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/windows/x64/bimg.lib" if="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/windows/x86/bgfx.lib" unless="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/windows/x86/bx.lib" unless="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/windows/x86/bimg.lib" unless="HXCPP_M64" />

				<lib name="d3d11.lib" />
				<lib name="d3d12.lib" />
				<lib name="d3dcompiler.lib" />
				<lib name="dxgi.lib" />
				<lib name="dxguid.lib" />
				<lib name="vulkan-1.lib" />
				<lib name="opengl32.lib" />
				<lib name="gdi32.lib" />
				<lib name="kernel32.lib" />
				<lib name="user32.lib" />
				<lib name="shell32.lib" />
				<lib name="ole32.lib" />
				<lib name="advapi32.lib" />
				<lib name="psapi.lib" />
				<lib name="SDL2.lib" />
			</section>

			<section if="linux">
				<file name="${BGFX_DIR}/project/bgfx_bridge.cpp" />
				<file name="${BGFX_DIR}/native/fsr2_bridge.cpp" />

				<lib name="${BGFX_DIR}/lib/linux/x64/libbgfx.a" if="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/linux/x64/libbx.a" if="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/linux/x64/libbimg.a" if="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/linux/x86/libbgfx.a" unless="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/linux/x86/libbx.a" unless="HXCPP_M64" />
				<lib name="${BGFX_DIR}/lib/linux/x86/libbimg.a" unless="HXCPP_M64" />

				<lib name="-lX11" />
				<lib name="-lXext" />
				<lib name="-lvulkan" />
				<lib name="-lGL" />
				<lib name="-ldl" />
				<lib name="-lpthread" />
				<lib name="-lrt" />
				<lib name="-ludev" />
				<lib name="-lSDL2" />
			</section>
		</target>
	</xml>
